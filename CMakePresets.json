{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Debug (default)",
            "binaryDir": "${sourceDir}/build/default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "clang",
            "displayName": "Debug (clang++, Ninja)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CONTINUI_BUILD_BACKEND_DAWN": "ON"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Release (clang++, Ninja)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/clang-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CONTINUI_BUILD_BACKEND_DAWN": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default", "configuration": "Debug" },
        { "name": "release", "configurePreset": "release", "configuration": "Release" },
        { "name": "clang", "configurePreset": "clang" },
        { "name": "clang-release", "configurePreset": "clang-release" }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "configuration": "Debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "clang",
            "configurePreset": "clang",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release",
            "output": { "outputOnFailure": true }
        }
    ]
}
